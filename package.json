{
  "name": "backup-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local database backups and exploration for MongoDB, PostgreSQL, MySQL/MariaDB, SQLite and SQL Server, plus Mongo password rotation",
  "scripts": {
    "start": "node scripts/launch.js start",
    "dev": "node scripts/launch.js dev",
    "worker": "node src/worker.js",
    "build:ui": "node scripts/build-ui.js",
    "install:service": "node scripts/install-service.js",
    "uninstall:service": "node scripts/uninstall-service.js",
    "test": "node --test ./test/seed-format.test.js ./test/seeds-sqlite.test.js ./test/rotation-audit.test.js ./test/dashboards.test.js ./test/schema-format.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.922.0",
    "@dagrejs/dagre": "^3.1.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xyflow/react": "^13.0.3",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "bson": "^6.10.4",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "echarts": "^6.1.0",
    "express": "^5.1.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.80.0",
    "mongodb": "^6.21.0",
    "motion": "^14.14.0",
    "mssql": "^12.8.1",
    "mysql2": "^3.24.6",
    "node-cron": "^4.2.1",
    "open": "^10.2.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
